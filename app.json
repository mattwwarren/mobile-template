{
  "expo": {
    "name": "Mobile Template",
    "slug": "mobile-template",
    "scheme": "mobile-template",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "ios": { "bundleIdentifier": "com.example.mobiletemplate" },
    "android": { "package": "com.example.mobiletemplate" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
